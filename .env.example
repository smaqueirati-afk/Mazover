# ============================================================================
# MAZOVER · Variables de entorno
# Copiá este archivo como .env.local y completá con tus credenciales de Supabase.
# NUNCA subas .env.local al repo. La service_role NUNCA debe llevar NEXT_PUBLIC_.
# ============================================================================

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Solo servidor (opcional, para tareas administrativas). NO exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# URL pública del sitio (para metadata / SEO / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
